    {
      "parameters": {
        "jsCode": "// Scoring simple et transparent d'un lead (0-100), sans service payant.\nconst b = $input.item.json.body || {};\nconst s = v => String(v == null ? '' : v).trim();\nconst nom = s(b.nom);\nconst email = s(b.email).toLowerCase();\nconst entreprise = s(b.entreprise);\nconst besoin = s(b.besoin);\n\nlet score = 10;\nconst domaine = email.split('@')[1] || '';\nconst generiques = ['gmail.com', 'yahoo.fr', 'yahoo.com', 'hotmail.com', 'hotmail.fr', 'outlook.com',\n  'outlook.fr', 'live.fr', 'icloud.com', 'free.fr', 'orange.fr', 'wanadoo.fr', 'laposte.net', 'sfr.fr'];\nif (domaine && !generiques.includes(domaine)) score += 25;   // email professionnel\nif (entreprise) score += 20;                                  // entreprise renseignée\nif (besoin.length > 20) score += 10;                          // besoin décrit\nif (besoin.length > 80) score += 5;                           // besoin détaillé\n\nconst motsCles = [['automatis', 10], ['crm', 8], ['devis', 8], ['factur', 8], ['chatbot', 8], [' ia ', 6],\n  ['intelligence artificielle', 6], ['scraping', 6], ['urgent', 10], ['rapidement', 5], ['budget', 5],\n  ['rendez-vous', 6], ['n8n', 8], ['notion', 6], ['airtable', 6], ['email', 4], ['relance', 6]];\nconst texte = ' ' + besoin.toLowerCase() + ' ';\nfor (const [mot, pts] of motsCles) if (texte.includes(mot)) score += pts;\n\nscore = Math.max(0, Math.min(100, score));\nconst priorite = score >= 70 ? 'Chaud' : score >= 40 ? 'Tiède' : 'Froid';\n\nreturn { json: {\n  nom, email, entreprise, besoin, score, priorite,\n  date: new Date().toISOString(),\n  source: 'Site de démos',\n  emailValide: /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email),\n} };\n",
        "mode": "runOnceForEachItem"
      },
