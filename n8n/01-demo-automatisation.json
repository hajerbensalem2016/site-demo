        "sendTo": "={{ $('Normaliser le lead').first().json.email }}",
        "subject": "=Bienvenue {{ $('Normaliser le lead').first().json.nom }} — votre demande est bien reçue",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;color:#222\"><h2 style=\"margin:0 0 12px\">Bonjour {{ $('Normaliser le lead').first().json.nom }},</h2><p>Merci pour votre demande{{ $('Normaliser le lead').first().json.entreprise ? ' pour <b>' + $('Normaliser le lead').first().json.entreprise + '</b>' : '' }}. Elle vient d'être enregistrée automatiquement dans notre CRM.</p><p style=\"background:#f4f4f5;padding:12px;border-radius:8px\"><b>Votre besoin :</b><br>{{ $('Normaliser le lead').first().json.besoin || 'non précisé' }}</p><p>Je reviens vers vous sous 24 h avec une première proposition.</p><p>À très vite,<br><b>Hajer</b><br>Automatisation &amp; IA</p><p style=\"color:#888;font-size:12px;margin-top:24px\">Cet email a été envoyé automatiquement par un workflow n8n ({{ $('Normaliser le lead').first().json.date }}).</p></div>",
        "options": {
          "appendAttribution": false,
          "senderName": "Hajer — Automatisation & IA"
        }
      },
